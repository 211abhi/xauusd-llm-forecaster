# ── Config & Docs ─────────────────────────────────────────────
# base_config.yaml and configs/{VARIANT}_config.yaml are regenerated every
# session by the notebook (device, output_steps, variant paths) — never track
# the runtime file, only the committed example.
*.yaml
*.yml
!configs/base_config.example.yaml
*.md
*.txt

# ── Data (never commit raw/processed data) ────────────────────
data/
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# ── Checkpoints & Model Weights ───────────────────────────────
*.pt
*.pth
*.ckpt
*.npy
*.npz
!checkpoints/encoder/best_encoder.pt
!checkpoints/soft_prompt/best_soft_prompt.npy
!checkpoints/soft_prompt/*/best_soft_prompt.npy
!checkpoints/pred_head/best_pred_head.pt
!checkpoints/pred_head/*/best_pred_head.pt

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── LLM Cache ─────────────────────────────────────────────────
.cache/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
a.IPYNB

# ── Env & Secrets ─────────────────────────────────────────────
.env
*.env.*

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
